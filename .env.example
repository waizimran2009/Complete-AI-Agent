# =============================================
# Complete AI Agent — Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# ── AI MODEL ──────────────────────────────────
# PRIMARY: Groq API — runs Llama 3.3 70B (open source, free, extremely fast)
# Sign up FREE at: https://console.groq.com → API Keys → Create key
GROQ_API_KEY=gsk_your_groq_key_here

# FALLBACK: Gemini 1.5 Flash (used when GROQ_API_KEY is not set)
# Get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AUTHENTICATION ─────────────────────────────
# Set any password to protect the dashboard
# Leave blank for open access (not recommended for production)
ACCESS_PASSWORD=your_strong_password_here

# Secret for signing JWT tokens — generate any random string
JWT_SECRET=change_this_to_a_random_64_char_string

# ── DATABASE (Supabase) ────────────────────────
# Sign up free at: https://supabase.com
# Then run database/schema.sql in your Supabase SQL editor
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── EMAIL AUTOMATION ───────────────────────────
# Use your Gmail address
# Generate App Password at: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
EMAIL_USER=your_company@gmail.com
EMAIL_PASS=your_gmail_app_password_16_chars

# ── CALL AUTOMATION (Twilio) ───────────────────
# Sign up at: https://twilio.com (free trial gives $15 credit)
# Get a phone number in Twilio console
# Set webhook URL: https://YOUR-DOMAIN/api/calls/webhook
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── POST IMAGE GENERATION (OpenAI DALL-E) ──────
# Sign up at: https://platform.openai.com
# DALL-E 3: ~$0.04 per image
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ── COMPANY INFO ───────────────────────────────
# Used by the AI phone receptionist
COMPANY_NAME=Your Company Name
COMPANY_SERVICES=software development, AI consulting, web design

# ── SERVER ────────────────────────────────────
PORT=3000
NODE_ENV=production
